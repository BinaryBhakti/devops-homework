# Rendered at container start by the nginx image's envsubst step:
# ${BACKEND_URL} comes from the environment (http://backend:8000 in Compose, the backend
# Service's FQDN in Kubernetes). The course config hard-coded "backend:8000", a name that does
# not exist in Kubernetes — and nginx resolves a literal proxy_pass host ONCE, at startup, so
# an unresolvable name makes the whole frontend crash-loop.
#
# Here the upstream is a variable, so nginx resolves it per request through the container's
# own DNS server (NGINX_LOCAL_RESOLVERS, filled in from /etc/resolv.conf by the image). If the
# backend is missing, the UI still loads and /api answers 502 — a degraded page, not a dead one.
# (nginx's resolver ignores DNS search domains: in Kubernetes BACKEND_URL must be a full FQDN.)
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  location /api/ {
    set $backend_upstream ${BACKEND_URL};
    proxy_pass $backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # the frontend's own probe target: does not depend on the backend
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
}
